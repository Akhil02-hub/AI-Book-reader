{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "memory": 1024,
        "maxDuration": 30,
        "includeFiles": [
          "index.html",
          "app.js",
          "styles.css",
          "logo.png",
          "fonts/dm-sans.woff2",
          "fonts/playfair-display.woff2",
          "node_modules/jszip/dist/jszip.min.js",
          "node_modules/pdfjs-dist/build/pdf.mjs",
          "node_modules/pdfjs-dist/build/pdf.worker.min.mjs"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}