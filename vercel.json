{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "memory": 1024,
        "maxDuration": 30,
        "includeFiles": [
          "index.html",
          "app.js",
          "styles.css",
          "logo.png",
          "fonts/**",
          "node_modules/jszip/dist/jszip.min.js",
          "node_modules/pdfjs-dist/build/pdf.mjs",
          "node_modules/pdfjs-dist/build/pdf.worker.min.mjs"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/fonts/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}