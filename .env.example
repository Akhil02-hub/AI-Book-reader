# Local dev only — delete these on Vercel (Vercel manages env vars separately)
NODE_ENV=development
SESSION_SECRET=
APP_ORIGIN=http://127.0.0.1:3000

# Vercel — set these in Project → Settings → Environment Variables
# NODE_ENV=production
# SESSION_SECRET=<output of: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))">
# APP_ORIGIN=https://your-project.vercel.app
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=<from turso db auth tokens create>